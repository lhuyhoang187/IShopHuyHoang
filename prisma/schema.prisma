datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. NGƯỜI DÙNG & NHÂN SỰ NỘI BỘ
// -------------------------------------------------------------
model User {
  id         String   @id @default(cuid())
  username   String   @unique @db.VarChar(50)
  password   String   @db.VarChar(191)
  name       String   @db.VarChar(100)
  role       String   @default("cashier") @db.VarChar(20) // 'admin' | 'technician' | 'cashier' | 'pending'
  phone      String?  @db.VarChar(20)
  email      String?  @unique @db.VarChar(100)
  avatar     String?  @db.Text
  department String?  @db.VarChar(100)
  birthday   String?  @db.VarChar(50)
  address    String?  @db.VarChar(191)
  bio        String?  @db.Text
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  repairTickets RepairTicket[] @relation("TechnicianRepairs")

  @@index([role])
  @@index([isActive])
}

// -------------------------------------------------------------
// 2. KHÁCH HÀNG & THÀNH VIÊN
// -------------------------------------------------------------
model Customer {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(100)
  phone          String   @unique @db.VarChar(20)
  email          String?  @db.VarChar(100)
  password       String?  @db.VarChar(191)
  avatar         String?  @db.Text
  birthday       String?  @db.VarChar(50)
  gender         String?  @default("male") @db.VarChar(20)
  city           String?  @default("TP. Hồ Chí Minh") @db.VarChar(100)
  address        String?  @db.VarChar(191)
  membershipTier String?  @default("Thành viên mới") @db.VarChar(50)
  customerType   String?  @default("Khách lẻ") @db.VarChar(50)
  taxCode        String?  @db.VarChar(50)
  notes          String?  @db.Text
  totalSpent     Float    @default(0)
  points         Int      @default(0)
  purchaseCount  Int      @default(0)
  repairCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  invoices          Invoice[]           @relation("CustomerInvoices")
  repairTickets     RepairTicket[]      @relation("CustomerRepairs")
  redeemedGifts     RedeemedGift[]      @relation("CustomerRedeemedGifts")
  registeredDevices RegisteredDevice[]  @relation("CustomerDevices")
  notifications     EmailNotification[] @relation("CustomerEmails")
  reviews           ProductReview[]     @relation("CustomerReviews")
  warrantyClaims    WarrantyClaim[]     @relation("CustomerWarrantyClaims")
  repairBookings    RepairBooking[]     @relation("CustomerRepairBookings")

  @@index([phone])
  @@index([name])
  @@index([points])
  @@index([totalSpent])
}

// -------------------------------------------------------------
// 3. NHÀ CUNG CẤP & ĐỐI TÁC
// -------------------------------------------------------------
model Supplier {
  id             String   @id
  name           String   @db.VarChar(150)
  phone          String   @db.VarChar(20)
  email          String   @db.VarChar(100)
  address        String   @db.VarChar(191)
  contactPerson  String   @db.VarChar(100)
  totalPurchased Float    @default(0)
  currentDebt    Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  phoneStocks PhoneStock[]    @relation("SupplierPhoneStocks")
  orders      SupplierOrder[] @relation("SupplierOrders")

  @@index([name])
  @@index([phone])
}

// -------------------------------------------------------------
// 4. DANH MỤC ĐIỆN THOẠI MASTER
// -------------------------------------------------------------
model PhoneProduct {
  id           String      @id
  name         String      @db.VarChar(191)
  slug         String      @unique @db.VarChar(191)
  brand        String      @db.VarChar(50)
  brandRel     PhoneBrand? @relation("BrandPhoneProducts", fields: [brand], references: [name], onDelete: Restrict, onUpdate: Cascade)
  description  String      @db.Text
  rating       Float       @default(5.0)
  reviewCount  Int         @default(0)
  isHot        Boolean     @default(false)
  isNew        Boolean     @default(false)
  colors       String      @db.Text
  capacities   String      @db.Text
  specs        String      @db.Text
  warrantyInfo String      @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  phoneStocks PhoneStock[]   @relation("ProductPhoneStocks")
  variants    PhoneVariant[] @relation("ProductVariants")

  @@index([brand])
  @@index([isHot])
  @@index([isNew])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 5. KHO ĐIỆN THOẠI TỪNG CÁ THỂ (QUẢN LÝ THEO SỐ IMEI)
// -------------------------------------------------------------
model PhoneStock {
  imei                String       @id @db.VarChar(50)
  phoneId             String       @db.VarChar(50)
  phone               PhoneProduct @relation("ProductPhoneStocks", fields: [phoneId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  phoneName           String       @db.VarChar(191)
  color               String       @db.VarChar(100)
  capacity            String       @db.VarChar(50)
  costPrice           Float
  sellingPrice        Float
  supplierId          String       @db.VarChar(50)
  supplier            Supplier     @relation("SupplierPhoneStocks", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplierName        String       @db.VarChar(150)
  importDate          String       @db.VarChar(50)
  status              String       @default("in_stock") @db.VarChar(30) // 'in_stock' | 'sold' | 'reserved'
  warrantyMonths      Int          @default(12)
  rewardPoints        Int          @default(0)
  soldAt              String?      @db.VarChar(50)
  soldToCustomerName  String?      @db.VarChar(100)
  soldToCustomerPhone String?      @db.VarChar(20)
  soldInvoiceId       String?      @db.VarChar(50)
  soldInvoice         Invoice?     @relation("InvoicePhoneStocks", fields: [soldInvoiceId], references: [invoiceCode], onDelete: SetNull, onUpdate: Cascade)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt

  @@index([phoneId])
  @@index([supplierId])
  @@index([status])
  @@index([soldInvoiceId])
  @@index([soldToCustomerPhone])
  @@index([importDate])
}

// -------------------------------------------------------------
// 6. PHỤ KIỆN ĐIỆN THOẠI
// -------------------------------------------------------------
model AccessoryProduct {
  id                          String   @id
  name                        String   @db.VarChar(191)
  slug                        String   @unique @db.VarChar(191)
  category                    String   @db.VarChar(50)
  categoryName                String   @db.VarChar(100)
  barcode                     String   @unique @db.VarChar(50)
  brand                       String   @db.VarChar(100)
  costPrice                   Float
  sellingPrice                Float
  originalPrice               Float
  stock                       Int      @default(0)
  minStockAlert               Int      @default(5)
  imageUrl                    String   @db.Text
  description                 String   @db.Text
  specs                       String   @db.Text
  compatibleWith              String   @db.Text
  discountWhenBoughtWithPhone Int      @default(15)
  rewardPoints                Int      @default(0)
  pointsToRedeem              Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @default(now()) @updatedAt

  @@index([category])
  @@index([brand])
  @@index([barcode])
  @@index([stock])
}

// -------------------------------------------------------------
// 7. LINH KIỆN SỬA CHỮA
// -------------------------------------------------------------
model SparePart {
  id                String   @id
  name              String   @db.VarChar(191)
  category          String   @db.VarChar(50)
  categoryName      String   @db.VarChar(100)
  barcode           String   @unique @db.VarChar(50)
  compatibleModels  String   @db.Text
  costPrice         Float
  retailRepairPrice Float
  stock             Int      @default(0)
  unit              String   @default("cái") @db.VarChar(20)
  warrantyMonths    Int      @default(6)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  ticketsUsed RepairTicketPart[] @relation("SparePartUsed")

  @@index([category])
  @@index([barcode])
  @@index([stock])
}

// -------------------------------------------------------------
// 8. PHIẾU TIẾP NHẬN SỬA CHỮA THIẾT BỊ
// -------------------------------------------------------------
model RepairTicket {
  id                    String    @id
  ticketCode            String    @unique @db.VarChar(50)
  customerName          String    @db.VarChar(100)
  customerPhone         String    @db.VarChar(20)
  customer              Customer? @relation("CustomerRepairs", fields: [customerPhone], references: [phone], onDelete: Restrict, onUpdate: Cascade)
  customerAddress       String?   @db.VarChar(191)
  deviceModel           String    @db.VarChar(100)
  imeiOrSerial          String    @db.VarChar(50)
  unlockPasscode        String    @db.VarChar(50)
  appearanceCondition   String    @db.Text
  accessoriesIncluded   String    @db.Text
  issueDescription      String    @db.Text
  technicianNotes       String?   @db.Text
  status                String    @default("received") @db.VarChar(30)
  statusHistory         String    @db.Text
  partsUsed             String    @db.Text
  laborFee              Float     @default(0)
  totalAmount           Float     @default(0)
  estimatedDeliveryDate String    @db.VarChar(50)
  deadlineTime          String?   @db.VarChar(50)
  deadlineMinutes       Int?      @default(60)
  assignedBy            String?   @db.VarChar(100)
  receivedAt            String    @db.VarChar(50)
  deliveredAt           String?   @db.VarChar(50)
  technicianId          String?   @db.VarChar(50)
  technician            User?     @relation("TechnicianRepairs", fields: [technicianId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  technicianName        String?   @db.VarChar(100)
  warrantyPeriod        String    @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  parts      RepairTicketPart[]    @relation("TicketParts")
  statusLogs RepairStatusHistory[] @relation("TicketStatusHistory")

  @@index([status])
  @@index([customerPhone])
  @@index([imeiOrSerial])
  @@index([technicianId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 9. HÓA ĐƠN BÁN HÀNG & XUẤT KHO
// -------------------------------------------------------------
model Invoice {
  id                    String    @id
  invoiceCode           String    @unique @db.VarChar(50)
  customerName          String    @db.VarChar(100)
  customerPhone         String    @db.VarChar(20)
  customerEmail         String?   @db.VarChar(100)
  customerTier          String?   @db.VarChar(50)
  customer              Customer? @relation("CustomerInvoices", fields: [customerPhone], references: [phone], onDelete: Restrict, onUpdate: Cascade)
  items                 String    @db.Text
  subtotal              Float
  discount              Float     @default(0)
  totalAmount           Float
  pointsEarned          Int       @default(0)
  paymentMethod         String    @default("cash") @db.VarChar(30)
  cashReceived          Float?
  cashChange            Float?
  cashierName           String    @db.VarChar(100)
  warrantyNote          String    @db.Text
  status                String    @default("completed") @db.VarChar(30) // 'completed' | 'pending_admin_approval' | 'approved' | 'rejected'
  isLargeOrder          Boolean   @default(false)
  adminApprovalNote     String?   @db.Text
  approvedBy            String?   @db.VarChar(100)
  approvedAt            DateTime?
  isPreOrder            Boolean   @default(false)
  depositPercent        Float?
  depositAmount         Float?
  remainingBalance      Float?
  estimatedDeliveryDate String?   @db.VarChar(50)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  phoneStocks  PhoneStock[]  @relation("InvoicePhoneStocks")
  invoiceItems InvoiceItem[] @relation("InvoiceLineItems")

  @@index([customerPhone])
  @@index([paymentMethod])
  @@index([status])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 10. SỔ QUỸ THU CHI (TIỀN MẶT / CHUYỂN KHOẢN)
// -------------------------------------------------------------
model CashbookEntry {
  id            String   @id
  code          String   @unique @db.VarChar(50)
  date          String   @db.VarChar(50)
  type          String   @db.VarChar(20) // 'receipt' | 'payment'
  category      String   @db.VarChar(50)
  categoryLabel String   @db.VarChar(100)
  amount        Float
  paymentMethod String   @db.VarChar(30) // 'cash' | 'transfer'
  referenceCode String?  @db.VarChar(50)
  description   String   @db.Text
  creator       String   @db.VarChar(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([date])
  @@index([type])
  @@index([category])
  @@index([referenceCode])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 11. ĐƠN ĐẶT HÀNG NHẬP KHO TỪ NHÀ CUNG CẤP
// -------------------------------------------------------------
model SupplierOrder {
  id            String   @id
  orderCode     String   @unique @db.VarChar(50)
  supplierId    String   @db.VarChar(50)
  supplier      Supplier @relation("SupplierOrders", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplierName  String   @db.VarChar(150)
  date          String   @db.VarChar(50)
  type          String   @db.VarChar(50)
  itemsSummary  String   @db.Text
  totalAmount   Float
  paidAmount    Float
  debtAmount    Float
  status        String   @db.VarChar(30)
  notes         String   @db.Text
  importedImeis String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  orderItems SupplierOrderItem[] @relation("OrderItems")

  @@index([supplierId])
  @@index([date])
  @@index([status])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 12. CẤU HÌNH CỬA HÀNG & VIETQR
// -------------------------------------------------------------
model StoreSetting {
  id                          String   @id @default("default")
  storeName                   String   @default("iShop Huy Hoàng") @db.VarChar(150)
  hotline                     String   @default("0909.123.456") @db.VarChar(20)
  address                     String   @default("45 Lê Văn Việt, TP. Thủ Đức, TP.HCM") @db.VarChar(191)
  email                       String   @default("contact@ishophuyhoang.vn") @db.VarChar(100)
  bankId                      String   @default("MB") @db.VarChar(20)
  bankAccountNo               String   @default("0988888999") @db.VarChar(50)
  bankAccountName             String   @default("NGUYEN HUY HOANG") @db.VarChar(100)
  defaultWarrantyNote         String   @default("Bảo hành điện tử chính hãng 12 tháng tại hệ thống iShop Huy Hoàng.") @db.VarChar(500)
  returnPolicy                String?  @db.VarChar(500)
  receiptFooter               String?  @db.VarChar(500)
  posDiscountRequiresApproval Boolean  @default(true)
  updatedAt                   DateTime @default(now()) @updatedAt
}

// -------------------------------------------------------------
// 13. NHẬT KÝ KIỂM TOÁN HỆ THỐNG (AUDIT LOGS)
// -------------------------------------------------------------
model AuditLog {
  id          String   @id @default(cuid())
  action      String   @db.VarChar(100)
  entity      String   @db.VarChar(50)
  entityId    String   @db.VarChar(100)
  performedBy String   @db.VarChar(100)
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 14. CHIẾN DỊCH KHUYẾN MÃI & FLASH SALE CỬA HÀNG
// -------------------------------------------------------------
model PromotionCampaign {
  id             String   @id @default(cuid())
  title          String   @db.VarChar(191)
  description    String   @db.Text
  badgeText      String?  @db.VarChar(100)
  discountType   String   @default("percentage") @db.VarChar(30) // 'percentage' | 'fixed_amount'
  discountValue  Float
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(true)
  targetCategory String   @default("all") @db.VarChar(50) // 'all' | 'phones' | 'accessories' | 'repairs'
  bannerGradient String?  @db.VarChar(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([isActive])
  @@index([startDate, endDate])
}

// -------------------------------------------------------------
// 15. MÃ QR KHUYẾN MÃI & VOUCHER CÓ THỜI GIAN ĐẾM NGƯỢC
// -------------------------------------------------------------
model PromoQRCode {
  id            String   @id @default(cuid())
  code          String   @unique @db.VarChar(50)
  title         String   @db.VarChar(191)
  description   String   @db.Text
  discountType  String   @default("percentage") @db.VarChar(30) // 'percentage' | 'fixed_amount'
  discountValue Float
  minOrderValue Float    @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  qrPayload     String   @db.Text
  bannerColor   String?  @db.VarChar(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([code])
  @@index([isActive])
}

// -------------------------------------------------------------
// 16. LỊCH SỬ ĐỔI PHỤ KIỆN / QUÀ BẰNG ĐIỂM THƯỞNG
// -------------------------------------------------------------
model RedeemedGift {
  id             String    @id @default(cuid())
  giftCode       String    @unique @db.VarChar(50)
  customerId     String?   @db.VarChar(50)
  customer       Customer? @relation("CustomerRedeemedGifts", fields: [customerId], references: [id], onDelete: SetNull)
  customerPhone  String    @db.VarChar(20)
  customerName   String    @db.VarChar(100)
  accessoryId    String    @db.VarChar(50)
  accessoryName  String    @db.VarChar(191)
  accessoryImage String    @db.Text
  pointsRedeemed Int
  redeemedAt     DateTime  @default(now())
  status         String    @default("active") @db.VarChar(30) // 'active' | 'used' | 'delivered'
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([giftCode])
  @@index([customerPhone])
  @@index([status])
}

// -------------------------------------------------------------
// 17. HỘ CHIẾU THIẾT BỊ / THIẾT BỊ ĐÃ ĐĂNG KÝ (DEVICE PASSPORT)
// -------------------------------------------------------------
model RegisteredDevice {
  id                  String    @id @default(cuid())
  imei                String    @unique @db.VarChar(50)
  productName         String    @db.VarChar(191)
  phoneId             String?   @db.VarChar(50)
  color               String?   @db.VarChar(100)
  capacity            String?   @db.VarChar(50)
  customerId          String?   @db.VarChar(50)
  customer            Customer? @relation("CustomerDevices", fields: [customerId], references: [id], onDelete: SetNull)
  customerPhone       String    @db.VarChar(20)
  customerName        String    @db.VarChar(100)
  customerEmail       String?   @db.VarChar(100)
  purchaseInvoiceCode String?   @db.VarChar(50)
  purchaseDate        String    @db.VarChar(50)
  warrantyExpiryDate  String    @db.VarChar(50)
  purchasePrice       Float     @default(0)
  repairHistoryCodes  String?   @db.Text // JSON string array of SC-xxx codes
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([imei])
  @@index([customerPhone])
}

// -------------------------------------------------------------
// 18. NHẬT KÝ EMAIL & THÔNG BÁO KHÁCH HÀNG (NOTIFICATION HUB)
// -------------------------------------------------------------
model EmailNotification {
  id             String    @id @default(cuid())
  toEmail        String    @db.VarChar(100)
  customerName   String    @db.VarChar(100)
  customerPhone  String?   @db.VarChar(20)
  customerId     String?   @db.VarChar(50)
  customer       Customer? @relation("CustomerEmails", fields: [customerId], references: [id], onDelete: SetNull)
  subject        String    @db.VarChar(255)
  type           String    @db.VarChar(50) // 'deposit_invoice' | 'purchase_invoice' | 'repair_receipt' | 'repair_status_update' | 'reward_redeem'
  title          String    @db.VarChar(255)
  contentSummary String    @db.Text
  htmlContent    String    @db.LongText
  sentAt         DateTime  @default(now())
  referenceCode  String    @db.VarChar(50)
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([toEmail])
  @@index([customerPhone])
  @@index([referenceCode])
  @@index([type])
}

// -------------------------------------------------------------
// 19. MA TRẬN PHÂN QUYỀN ĐỘNG THEO VAI TRÒ (RBAC PERMISSIONS)
// -------------------------------------------------------------
model RolePermission {
  id          String   @id @db.VarChar(50)
  module      String   @db.VarChar(150)
  category    String   @db.VarChar(50)
  description String?  @db.Text
  admin       Boolean  @default(true)
  tech        Boolean  @default(false)
  cashier     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([category])
}

// -------------------------------------------------------------
// 20. ĐÁNH GIÁ & PHẢN HỒI SẢN PHẨM / DỊCH VỤ TỪ KHÁCH HÀNG
// -------------------------------------------------------------
model ProductReview {
  id            String    @id @default(cuid())
  productId     String?   @db.VarChar(50)
  productType   String    @default("phone") @db.VarChar(30) // 'phone' | 'accessory' | 'repair'
  customerId    String?   @db.VarChar(50)
  customer      Customer? @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String    @db.VarChar(100)
  customerPhone String?   @db.VarChar(20)
  rating        Int       @default(5)
  comment       String    @db.Text
  isApproved    Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([productId])
  @@index([isApproved])
}

// -------------------------------------------------------------
// 21. DANH MỤC PHỤ KIỆN ĐIỆN THOẠI (DYNAMIC ACCESSORY CATEGORIES)
// -------------------------------------------------------------
model AccessoryCategory {
  id           String   @id @default(cuid())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  icon         String?  @db.VarChar(100)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([displayOrder])
}

// -------------------------------------------------------------
// 22. DANH MỤC LINH KIỆN SỬA CHỮA (SPARE PART CATEGORIES)
// -------------------------------------------------------------
model SparePartCategory {
  id           String   @id @default(cuid())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([code])
  @@index([isActive])
}

// -------------------------------------------------------------
// 23. BẢNG GIÁ DỊCH VỤ SỬA CHỮA ICARE (REPAIR SERVICES)
// -------------------------------------------------------------
model RepairService {
  id               String   @id @default(cuid())
  name             String   @db.VarChar(191) // 'Thay Pin Pisen Chính Hãng', 'Ép Kính Cảm Ứng Chân Không'
  category         String   @db.VarChar(50) // 'battery' | 'screen' | 'glass' | 'charge_port' | 'camera' | 'other'
  deviceBrand      String   @default("Apple") @db.VarChar(50) // 'Apple' | 'Samsung' | 'Xiaomi' | 'All'
  deviceModels     String   @db.Text // 'iPhone 11 / 12 / 13 Series', 'Galaxy S24 Ultra'
  price            Float
  originalPrice    Float?
  warrantyPeriod   String   @default("12 Tháng") @db.VarChar(100)
  estimatedMinutes Int      @default(30)
  description      String?  @db.Text
  isFeatured       Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([deviceBrand])
  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
}

// -------------------------------------------------------------
// 24. ĐẶT LỊCH HẸN SỬA CHỮA TRỰC TUYẾN (ONLINE REPAIR BOOKING)
// -------------------------------------------------------------
model RepairBooking {
  id              String    @id @default(cuid())
  bookingCode     String    @unique @db.VarChar(50)
  customerName    String    @db.VarChar(100)
  customerPhone   String    @db.VarChar(20)
  customerId      String?   @db.VarChar(50)
  customer        Customer? @relation("CustomerRepairBookings", fields: [customerId], references: [id], onDelete: SetNull)
  deviceModel     String    @db.VarChar(100)
  serviceName     String    @db.VarChar(191)
  appointmentDate String    @db.VarChar(50)
  appointmentTime String    @db.VarChar(50)
  notes           String?   @db.Text
  status          String    @default("pending") @db.VarChar(30) // 'pending' | 'confirmed' | 'converted_to_ticket' | 'cancelled'
  ticketCode      String?   @db.VarChar(50)
  branchName      String?   @db.VarChar(150)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([bookingCode])
  @@index([customerPhone])
  @@index([status])
  @@index([appointmentDate])
}

// -------------------------------------------------------------
// 25. DANH MỤC THƯƠNG HIỆU THIẾT BỊ (PHONE & DEVICE BRANDS)
// -------------------------------------------------------------
model PhoneBrand {
  id           String   @id @default(cuid())
  name         String   @unique @db.VarChar(50) // 'Apple', 'Samsung', 'Xiaomi', 'OPPO', 'Google'
  slug         String   @unique @db.VarChar(50)
  logoUrl      String?  @db.Text
  description  String?  @db.Text
  country      String?  @db.VarChar(50)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  phoneProducts PhoneProduct[] @relation("BrandPhoneProducts")

  @@index([slug])
  @@index([isActive])
}

// -------------------------------------------------------------
// 26. HỆ THỐNG CHI NHÁNH CỬA HÀNG (STORE BRANCHES)
// -------------------------------------------------------------
model StoreBranch {
  id           String   @id @default(cuid())
  code         String   @unique @db.VarChar(50) // 'CN-THUDUC', 'CN-Q10'
  name         String   @db.VarChar(150)
  phone        String   @db.VarChar(20)
  address      String   @db.VarChar(191)
  district     String?  @db.VarChar(100)
  city         String   @default("TP. Hồ Chí Minh") @db.VarChar(100)
  openingHours String   @default("08:00 - 21:30") @db.VarChar(100)
  mapUrl       String?  @db.Text
  isMainBranch Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([code])
  @@index([isActive])
}

// -------------------------------------------------------------
// 27. YÊU CẦU & KHIẾU NẠI BẢO HÀNH (WARRANTY CLAIMS)
// -------------------------------------------------------------
model WarrantyClaim {
  id               String    @id @default(cuid())
  claimCode        String    @unique @db.VarChar(50) // 'BH-2608-001'
  imeiOrSerial     String    @db.VarChar(50)
  customerName     String    @db.VarChar(100)
  customerPhone    String    @db.VarChar(20)
  customerEmail    String?   @db.VarChar(100)
  customerId       String?   @db.VarChar(50)
  customer         Customer? @relation("CustomerWarrantyClaims", fields: [customerId], references: [id], onDelete: SetNull)
  productName      String    @db.VarChar(191)
  issueDescription String    @db.Text
  status           String    @default("pending") @db.VarChar(30) // 'pending' | 'accepted' | 'processing' | 'completed' | 'rejected'
  resolutionNotes  String?   @db.Text
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([claimCode])
  @@index([imeiOrSerial])
  @@index([customerPhone])
  @@index([status])
}

// -------------------------------------------------------------
// 28. CHI TIẾT SẢN PHẨM HÓA ĐƠN BÁN HÀNG (3NF INVOICE ITEMS)
// -------------------------------------------------------------
model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceCode    String   @db.VarChar(50)
  invoice        Invoice  @relation("InvoiceLineItems", fields: [invoiceCode], references: [invoiceCode], onDelete: Cascade, onUpdate: Cascade)
  itemType       String   @db.VarChar(30) // 'phone' | 'accessory' | 'repair'
  productId      String?  @db.VarChar(50)
  productName    String   @db.VarChar(191)
  imei           String?  @db.VarChar(50)
  color          String?  @db.VarChar(100)
  capacity       String?  @db.VarChar(50)
  unitPrice      Float
  quantity       Int      @default(1)
  discount       Float    @default(0)
  subtotal       Float
  warrantyMonths Int      @default(12)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([invoiceCode])
  @@index([productId])
  @@index([imei])
}

// -------------------------------------------------------------
// 29. LINH KIỆN SỬ DỤNG TRONG PHIẾU SỬA CHỮA (3NF REPAIR TICKET PARTS)
// -------------------------------------------------------------
model RepairTicketPart {
  id             String       @id @default(cuid())
  ticketCode     String       @db.VarChar(50)
  ticket         RepairTicket @relation("TicketParts", fields: [ticketCode], references: [ticketCode], onDelete: Cascade, onUpdate: Cascade)
  sparePartId    String?      @db.VarChar(50)
  sparePart      SparePart?   @relation("SparePartUsed", fields: [sparePartId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  partName       String       @db.VarChar(191)
  quantity       Int          @default(1)
  unitPrice      Float
  warrantyMonths Int          @default(6)
  createdAt      DateTime     @default(now())

  @@index([ticketCode])
  @@index([sparePartId])
}

// -------------------------------------------------------------
// 30. TIẾN ĐỘ & LỊCH SỬ TRẠNG THÁI SỬA CHỮA (3NF REPAIR STATUS HISTORY)
// -------------------------------------------------------------
model RepairStatusHistory {
  id          String       @id @default(cuid())
  ticketCode  String       @db.VarChar(50)
  ticket      RepairTicket @relation("TicketStatusHistory", fields: [ticketCode], references: [ticketCode], onDelete: Cascade, onUpdate: Cascade)
  status      String       @db.VarChar(30)
  statusLabel String       @db.VarChar(100)
  note        String?      @db.Text
  updatedBy   String?      @db.VarChar(100)
  createdAt   DateTime     @default(now())

  @@index([ticketCode])
  @@index([status])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 31. BIẾN THỂ MÀU SẮC & DUNG LƯỢNG ĐIỆN THOẠI (3NF PHONE VARIANTS)
// -------------------------------------------------------------
model PhoneVariant {
  id            String       @id @default(cuid())
  phoneId       String       @db.VarChar(50)
  phone         PhoneProduct @relation("ProductVariants", fields: [phoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  colorName     String       @db.VarChar(100)
  colorHex      String?      @db.VarChar(30)
  imageUrl      String?      @db.Text
  capacity      String       @db.VarChar(50)
  price         Float
  originalPrice Float?
  isOutOfStock  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@index([phoneId])
  @@index([capacity])
}

// -------------------------------------------------------------
// 32. CHI TIẾT MẶT HÀNG TRONG ĐƠN NHẬP KHO NCC (3NF SUPPLIER ORDER ITEMS)
// -------------------------------------------------------------
model SupplierOrderItem {
  id          String        @id @default(cuid())
  orderCode   String        @db.VarChar(50)
  order       SupplierOrder @relation("OrderItems", fields: [orderCode], references: [orderCode], onDelete: Cascade, onUpdate: Cascade)
  itemType    String        @default("phone") @db.VarChar(30) // 'phone' | 'accessory' | 'spare_part'
  productId   String?       @db.VarChar(50)
  productName String        @db.VarChar(191)
  color       String?       @db.VarChar(100)
  capacity    String?       @db.VarChar(50)
  quantity    Int           @default(1)
  unitCost    Float
  totalCost   Float
  imei        String?       @db.VarChar(50)
  createdAt   DateTime      @default(now())

  @@index([orderCode])
  @@index([productId])
  @@index([imei])
}
