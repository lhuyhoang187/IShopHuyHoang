erDiagram
    %% ======================================================
    %% iShop Huy Hoàng - 3NF / BCNF Relational Schema (27 InnoDB Tables, 22 FKs)
    %% ======================================================

    %% 1. DANH MỤC & SẢN PHẨM ĐIỆN THOẠI (3NF)
    PhoneBrand ||--o{ PhoneProduct : "brandId"
    PhoneProduct ||--o{ PhoneColor : "phoneId"
    PhoneColor ||--o{ PhoneVariant : "colorId"
    PhoneProduct ||--o{ PhoneStock : "phoneId"

    %% 2. PHỤ KIỆN & LINH KIỆN SỬA CHỮA (3NF)
    AccessoryCategory ||--o{ AccessoryProduct : "categoryId"
    SparePartCategory ||--o{ SparePart : "categoryId"
    SparePart ||--o{ SparePartCompatibility : "sparePartId"

    %% 3. NHÀ CUNG CẤP & NHẬP KHO (3NF)
    Supplier ||--o{ PhoneStock : "supplierId"
    Supplier ||--o{ SupplierOrder : "supplierId"
    SupplierOrder ||--o{ SupplierOrderItem : "orderCode"

    %% 4. BÁN HÀNG POS & HÓA ĐƠN (3NF)
    Customer ||--o{ Invoice : "customerId"
    Invoice ||--o{ InvoiceItem : "invoiceCode"
    Invoice ||--o{ PhoneStock : "soldInvoiceId"

    %% 5. SỬA CHỮA iCARE & ĐẶT LỊCH (3NF)
    PhoneBrand ||--o{ RepairService : "brandId"
    PhoneBrand ||--o{ RepairBookingOption : "brandId"
    Customer ||--o{ RepairBooking : "customerId"
    RepairTicket ||--o{ RepairBooking : "ticketCode"
    Customer ||--o{ RepairTicket : "customerId"
    User ||--o{ RepairTicket : "technicianId"
    RepairTicket ||--o{ RepairTicketPart : "ticketCode"
    SparePart ||--o{ RepairTicketPart : "sparePartId"
    RepairTicket ||--o{ RepairStatusHistory : "ticketCode"

    %% ======================================================
    %% CHI TIẾT 27 THỰC THỂ CHUẨN HÓA 3NF
    %% ======================================================

    User {
        varchar id PK
        varchar username UK
        varchar password
        varchar name
        varchar role
        varchar email UK
        varchar phone
        longtext avatar
        tinyint isActive
        varchar department
    }

    RolePermission {
        varchar id PK
        varchar module
        varchar category
        text description
        tinyint admin
        tinyint tech
        tinyint cashier
    }

    StoreSetting {
        varchar id PK
        varchar storeName
        varchar hotline
        varchar address
        varchar email
        varchar bankId
        varchar bankAccountNo
        varchar bankAccountName
        tinyint posDiscountRequiresApproval
    }

    Customer {
        varchar id PK
        varchar name
        varchar phone UK
        varchar email
        varchar address
        varchar city
        varchar membershipTier
        varchar customerType
        double totalSpent
        int points
        int purchaseCount
        int repairCount
        longtext avatar
    }

    Supplier {
        varchar id PK
        varchar name
        varchar phone
        varchar email
        varchar address
        varchar contactPerson
        double totalPurchased
        double currentDebt
    }

    PhoneBrand {
        varchar id PK
        varchar name UK
        varchar slug UK
        varchar country
        int displayOrder
        tinyint isActive
    }

    PhoneProduct {
        varchar id PK
        varchar name
        varchar slug UK
        varchar brandId FK
        text description
